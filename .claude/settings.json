{
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(echo *)",
      "Bash(for *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(printf *)",
      "Bash(tail *)",
      "Skill(create-pr)",
      "Skill(fix-pr)",
      "Skill(retro)",
      "Skill(solve-issue)"
    ],
    "deny": [
      "Bash(git add --all)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Write(.env)"
    ],
    "ask": [
      "Bash(git reset *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/setup-remote.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "base-tools@canpok1-plugins": true
  },
  "extraKnownMarketplaces": {
    "canpok1-plugins": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  }
}
